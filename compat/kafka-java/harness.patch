+package kafka.utils
+
+import org.junit.jupiter.api.extension.{ConditionEvaluationResult, ExecutionCondition, ExtensionContext}
+
+/**
+ * Nisshi: when NISSHI_BOOTSTRAP is set, skips the test variants that cannot run against an external
+ * Nisshi broker: ZooKeeper and ZK-migration quorums, and the KIP-848 consumer group protocol.
+ */
+class NisshiExternalCondition extends ExecutionCondition {
+  override def evaluateExecutionCondition(context: ExtensionContext): ConditionEvaluationResult = {
+    if (sys.env.get("NISSHI_BOOTSTRAP").forall(_.isEmpty)) {
+      ConditionEvaluationResult.enabled("no external broker")
+    } else {
+      val name = context.getDisplayName
+      if (name.contains("quorum=zk")) {
+        ConditionEvaluationResult.disabled("Nisshi has no ZooKeeper mode")
+      } else if (name.contains("kip848") || name.contains("groupProtocol=consumer")) {
+        ConditionEvaluationResult.disabled("Nisshi does not advertise ConsumerGroupHeartbeat (KIP-848)")
+      } else {
+        ConditionEvaluationResult.enabled("runs against Nisshi")
+      }
+    }
+  }
+}
